# Distribution store credentials placeholder.
# Copy to credentials.yaml and fill in real values.
stores:
  steam:
    username: "PLACEHOLDER_STEAM_USERNAME"
    config_path: "/path/to/steam/config.vdf"
    depot_build_path: "/path/to/ContentBuilder"
  epic:
    client_id: "PLACEHOLDER_EPIC_CLIENT_ID"
    client_secret: "PLACEHOLDER_EPIC_CLIENT_SECRET"
    organization_id: "PLACEHOLDER_EPIC_ORG_ID"
  itch_io:
    api_key: "PLACEHOLDER_ITCH_API_KEY"
    butler_path: "/path/to/butler"
  gog:
    build_creator_path: "/path/to/GOGGalaxyPipelineBuilder"
    client_id: "PLACEHOLDER_GOG_CLIENT_ID"
    client_secret: "PLACEHOLDER_GOG_CLIENT_SECRET"
