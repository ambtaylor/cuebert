# Memory database configuration placeholder.
# Copy to credentials.yaml and fill in real values.
memory:
  db_path: ".cuebert/memory.db"
  mode: "text"  # "text" (FTS only) or "hybrid" (FTS + embeddings)
  embedding_model: "PLACEHOLDER_EMBEDDING_MODEL_NAME"
  embedding_api_key: "PLACEHOLDER_EMBEDDING_API_KEY"
  embedding_api_url: "PLACEHOLDER_EMBEDDING_API_URL"
