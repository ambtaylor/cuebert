# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
.env
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / TS
node_modules/
dist/
build/
*.log
npm-debug.log*

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Cuebert runtime
.cuebert/memory/memory.db
.cuebert/memory/*.db-wal
.cuebert/memory/*.db-shm
.cuebert/logs/
.cuebert/cache/
# Vault: ignore all vault files except tracked scaffold (README + .gitkeep)
.cuebert/vault/**
!.cuebert/vault/
!.cuebert/vault/README.md
!.cuebert/vault/.gitkeep
!.cuebert/vault/shared/
!.cuebert/vault/shared/.gitkeep
# Runtime trace artifacts — ignored except for curated documentation examples.
.cuebert/traces/*
!.cuebert/traces/play/
.cuebert/traces/play/*
!.cuebert/traces/play/example-*/
!.cuebert/traces/play/example-*/**
!.cuebert/traces/ship/
.cuebert/traces/ship/*
!.cuebert/traces/ship/example-*/
!.cuebert/traces/ship/example-*/**
# Ship traces: example-2026-04-20T12-30-00Z (M3-P3), example-2026-04-20T15-00-00Z (M7-P3 gate
# fixtures), and example-2026-04-20T16-00-00Z (M8-P3 cook/package/cert samples) are tracked
# under the un-ignore rules above (`example-*` / `example-*/**`).
# Asset sample trace (M4-P4 worked example) — keep in git
!.cuebert/traces/asset/
.cuebert/traces/asset/*
!.cuebert/traces/asset/example-*/
!.cuebert/traces/asset/example-*/**
# Unreal bridge sample trace (M5-P4 worked example) — keep in git
!.cuebert/traces/unreal/
.cuebert/traces/unreal/*
!.cuebert/traces/unreal/example-*/
!.cuebert/traces/unreal/example-*/**
.cuebert/credentials.local.json

# Secrets (belt and suspenders; vault is the real mechanism)
*.key
*.pem
*.p12
credentials.json
service-account*.json

# Unreal Engine (for later milestones)
Binaries/
DerivedDataCache/
Intermediate/
Saved/
*.VC.db
*.opensdf
*.sdf
*.sln
